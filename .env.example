# Configuración de la base de datos
DB_HOST=localhost
DB_NAME=mesa_partes_lurin
DB_USER=root
DB_PASS=
DB_PORT=3306
DB_CHARSET=utf8mb4
API_DECOLECTA_SERVER=https://api.decolecta.com/v1/
API_DECOLECTA_TOKEN=
# Otras configuraciones

# Entorno de la aplicación (SEC-09).
# local => se registra E_ALL en storage/php-error.log.
# produccion => se ocultan avisos de deprecación y el log es el único destino.
# En ambos casos la traza NUNCA se envía al navegador.
APP_ENV=local
APP_TIMEZONE=America/Lima
# Correo (E13)
MAIL_HABILITADO=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Mesa de Partes Lur�n"
MAIL_MESA_PARTES=
APP_URL=http://localhost
